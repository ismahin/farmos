{
  "name": "farm-erp",
  "version": "0.1.0",
  "private": true,
  "description": "FarmOS — Configurable, multi-tenant Agriculture ERP SaaS",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api:integration": "npm run test:integration --workspace=apps/api",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api"
  },
  "keywords": [
    "agriculture",
    "erp",
    "poultry",
    "farmos"
  ],
  "author": "FarmOS Team",
  "license": "UNLICENSED"
}
